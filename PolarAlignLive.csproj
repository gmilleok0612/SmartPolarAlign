<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PolarAlignLive</AssemblyName>
    <RootNamespace>PolarAlignLive</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin these to your installed NINA version (same advice as SmartGuider). -->
    <PackageReference Include="NINA.Plugin" Version="3.*" />
    <PackageReference Include="NINA.Core" Version="3.*" />
    <PackageReference Include="NINA.Equipment" Version="3.*" />
    <PackageReference Include="NINA.Image" Version="3.*" />
    <PackageReference Include="NINA.Profile" Version="3.*" />
    <PackageReference Include="NINA.WPF.Base" Version="3.*" />
    <PackageReference Include="NINA.Astrometry" Version="3.*" />
    <PackageReference Include="NINA.PlateSolving" Version="3.*" />
    <!-- Must match the version NINA itself references. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Ignore stray flat copies at the repo root; the real files live in Astro/, Properties/ and UI/. -->
  <ItemGroup>
    <Compile Remove="AssemblyInfo.cs;PolarMath.cs;PolarDisplay.cs;PolarAlignLiveTemplates.xaml.cs" />
    <Page Remove="PolarAlignLiveTemplates.xaml" />
    <None Remove="*.dll;*.pdb" />
  </ItemGroup>

</Project>
