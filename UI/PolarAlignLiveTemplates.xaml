<ResourceDictionary x:Class="PolarAlignLive.UI.PolarAlignLiveTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PolarAlignLive"
                    xmlns:ui="clr-namespace:PolarAlignLive.UI">

    <!-- All colours come from NightTheme (bound through the VM's Theme property). No hard-coded light colours. -->

    <BooleanToVisibilityConverter x:Key="PalBool" />
    <ui:SquareSizeConverter x:Key="PalSquare" Floor="320" />

    <Style x:Key="PalButton" TargetType="Button">
        <Setter Property="Foreground" Value="{Binding Theme.TextBrush}" />
        <Setter Property="Background" Value="{Binding Theme.FillBrush}" />
        <Setter Property="BorderBrush" Value="{Binding Theme.BorderBrushN}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <!-- NINA's implicit TextBlock style would otherwise force a light colour. -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented choice button (RadioButton) used for Night On/Off and Red/Green/White. -->
    <Style x:Key="PalChoice" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{Binding Theme.TextBrush}" />
        <Setter Property="Background" Value="{Binding Theme.FillBrush}" />
        <Setter Property="BorderBrush" Value="{Binding Theme.BorderBrushN}" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="8,4" Opacity="0.7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="3" />
                            <Setter TargetName="Bd" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PalTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{Binding Theme.TextBrush}" />
        <Setter Property="Background" Value="Black" />
        <Setter Property="BorderBrush" Value="{Binding Theme.BorderBrushN}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CaretBrush" Value="{Binding Theme.TextBrush}" />
        <Setter Property="SelectionBrush" Value="{Binding Theme.BorderBrushN}" />
        <Setter Property="SelectionTextBrush" Value="Black" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PalLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Theme.TextBrush}" />
    </Style>

    <Style x:Key="PalDimLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{Binding Theme.DimBrush}" />
    </Style>

    <!-- Key must be <VM full type name>_Dockable (NINA's pane template selector looks it up). -->
    <DataTemplate x:Key="PolarAlignLive.PolarAlignLiveVM_Dockable" DataType="{x:Type local:PolarAlignLiveVM}">
        <!-- NINA may host the panel in a ScrollViewer that measures it with unlimited height; pin the size to the visible area. -->
        <Border Background="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <DockPanel LastChildFill="True" Background="Black">

            <!-- Settings strip: outside the square, normal size, wraps when narrow. -->
            <StackPanel DockPanel.Dock="Top" Margin="6,4,6,2">
                <Button Content="{Binding SettingsToggleText}" Command="{Binding ToggleSettingsCommand}"
                        Style="{StaticResource PalButton}" HorizontalAlignment="Right" MinWidth="90" Padding="8,2" Margin="0,0,0,2" />
                <StackPanel  Margin="8,0" Visibility="{Binding SettingsOpen, Converter={StaticResource PalBool}}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Exp (s)" Style="{StaticResource PalLabel}" VerticalAlignment="Center" />
                <TextBox Width="50" Margin="4,0,12,0" Style="{StaticResource PalTextBox}" Text="{Binding ExposureTime, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="Gain" Style="{StaticResource PalLabel}" VerticalAlignment="Center" />
                <TextBox Width="50" Margin="4,0,12,0" Style="{StaticResource PalTextBox}" Text="{Binding Gain, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="Bin" Style="{StaticResource PalLabel}" VerticalAlignment="Center" />
                <TextBox Width="30" Margin="4,0,0,0" Style="{StaticResource PalTextBox}" Text="{Binding Binning, UpdateSourceTrigger=LostFocus}" />
            </WrapPanel>
            <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Auto: step°" Style="{StaticResource PalLabel}" VerticalAlignment="Center" />
                <TextBox Width="36" Margin="4,0,10,0" Style="{StaticResource PalTextBox}" Text="{Binding AutoStepDeg, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="min alt" Style="{StaticResource PalLabel}" VerticalAlignment="Center" />
                <TextBox Width="36" Margin="4,0,10,0" Style="{StaticResource PalTextBox}" Text="{Binding MinAltDeg, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="max alt" Style="{StaticResource PalLabel}" VerticalAlignment="Center" />
                <TextBox Width="36" Margin="4,0,0,0" Style="{StaticResource PalTextBox}" Text="{Binding MaxAltDeg, UpdateSourceTrigger=LostFocus}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Crop" Style="{StaticResource PalLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <RadioButton GroupName="PalCrop" Content="100%" Style="{StaticResource PalChoice}" MinWidth="44" IsChecked="{Binding Crop100, Mode=TwoWay}" />
                <RadioButton GroupName="PalCrop" Content="50%" Style="{StaticResource PalChoice}" MinWidth="44" IsChecked="{Binding Crop50, Mode=TwoWay}" />
                <RadioButton GroupName="PalCrop" Content="25%" Style="{StaticResource PalChoice}" MinWidth="44" IsChecked="{Binding Crop25, Mode=TwoWay}" />
            </StackPanel>
            </StackPanel>

            
                <WrapPanel Margin="6,6,6,0" VerticalAlignment="Center" Visibility="{Binding SettingsOpen, Converter={StaticResource PalBool}}">
                <TextBlock Text="Night" Style="{StaticResource PalLabel}" VerticalAlignment="Center" Margin="2,0,4,0" />
                <RadioButton GroupName="PalNight" Content="On" Style="{StaticResource PalChoice}" MinWidth="40"
                             IsChecked="{Binding Theme.NightOn, Mode=TwoWay}" />
                <RadioButton GroupName="PalNight" Content="Off" Style="{StaticResource PalChoice}" MinWidth="40"
                             IsChecked="{Binding Theme.NightOff, Mode=TwoWay}" />
                <TextBlock Text="  " />
                <RadioButton GroupName="PalColor" Content="Red" Style="{StaticResource PalChoice}" MinWidth="44"
                             IsChecked="{Binding Theme.ColorRed, Mode=TwoWay}" />
                <RadioButton GroupName="PalColor" Content="Green" Style="{StaticResource PalChoice}" MinWidth="44"
                             IsChecked="{Binding Theme.ColorGreen, Mode=TwoWay}" />
                <RadioButton GroupName="PalColor" Content="White" Style="{StaticResource PalChoice}" MinWidth="44"
                             IsChecked="{Binding Theme.ColorWhite, Mode=TwoWay}" />
                <Button Content="&#8722;" Style="{StaticResource PalButton}" MinWidth="30" Padding="6,2" Command="{Binding DimmerDownCommand}" />
                <TextBlock Text="{Binding Theme.DimmerText}" Style="{StaticResource PalLabel}" VerticalAlignment="Center" MinWidth="34" TextAlignment="Center" />
                <Button Content="+" Style="{StaticResource PalButton}" MinWidth="30" Padding="6,2" Command="{Binding DimmerUpCommand}" />
            </WrapPanel>
            </StackPanel>

            <!-- Largest square that fits, never smaller than 320; below that the panel scrolls. -->
            <ScrollViewer x:Name="SquareHost" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Black">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox.Width>
                        <MultiBinding Converter="{StaticResource PalSquare}">
                            <Binding Path="ActualWidth" ElementName="SquareHost" />
                            <Binding Path="ActualHeight" ElementName="SquareHost" />
                        </MultiBinding>
                    </Viewbox.Width>
                    <Viewbox.Height>
                        <MultiBinding Converter="{StaticResource PalSquare}">
                            <Binding Path="ActualWidth" ElementName="SquareHost" />
                            <Binding Path="ActualHeight" ElementName="SquareHost" />
                        </MultiBinding>
                    </Viewbox.Height>
                    <!-- Design size 440 x 440; everything inside scales together. -->
                    <Grid Width="440" Height="440" Background="Black">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="8,4,8,0">
                            <TextBlock Text="{Binding Instructions}" Style="{StaticResource PalLabel}" TextWrapping="Wrap" FontSize="14" />
                            <TextBlock Style="{StaticResource PalDimLabel}" FontSize="12" TextWrapping="Wrap">
                                <Run Text="{Binding FrameCountText, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding AxisQualityText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="4">
                            <ui:PolarDisplay MinHeight="60" MinWidth="60"
                                             Tint="{Binding Theme.TintColor}"
                                             MoveUp="{Binding MoveUpArcmin}" MoveEast="{Binding MoveEastArcmin}" HasSolution="{Binding HasSolution}" />
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,0,0,0" IsHitTestVisible="False">
                                <TextBlock Text="{Binding MoveUpText}" Style="{StaticResource PalLabel}" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="{Binding MoveEastText}" Style="{StaticResource PalLabel}" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{Binding TotalErrorText}" Style="{StaticResource PalDimLabel}" FontSize="15"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" IsHitTestVisible="False" />
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="8,2">
                            <Border Visibility="{Binding ConfirmPending, Converter={StaticResource PalBool}}"
                                    BorderBrush="{Binding Theme.TextBrush}" BorderThickness="3" CornerRadius="3" Padding="8" Margin="0,0,0,4"
                                    Background="{Binding Theme.FillBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ConfirmText}" Style="{StaticResource PalLabel}" TextWrapping="Wrap" FontWeight="Bold" FontSize="13" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                        <Button Content="SLEW" Style="{StaticResource PalButton}" Command="{Binding ConfirmSlewCommand}" />
                                        <Button Content="CANCEL" Style="{StaticResource PalButton}" Command="{Binding CancelSlewCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource PalDimLabel}" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>

                        <UniformGrid Grid.Row="3" Columns="3" Rows="2" Margin="5,2,5,6">
                            <Button Style="{StaticResource PalButton}" MinWidth="0" FontSize="14" Content="Capture Frame" Command="{Binding CaptureFrameCommand}" />
                            <Button Style="{StaticResource PalButton}" MinWidth="0" FontSize="14" Content="Auto Capture" Command="{Binding AutoCaptureCommand}" />
                            <Button Style="{StaticResource PalButton}" MinWidth="0" FontSize="14" Content="Tracking On" Command="{Binding TrackingOnCommand}" />
                            <Button Style="{StaticResource PalButton}" MinWidth="0" FontSize="14" Content="Start Live" Command="{Binding StartLiveCommand}" />
                            <Button Style="{StaticResource PalButton}" MinWidth="0" FontSize="14" Content="Stop" Command="{Binding StopCommand}" />
                            <Button Style="{StaticResource PalButton}" MinWidth="0" FontSize="14" Content="Reset" Command="{Binding ResetCommand}" />
                        </UniformGrid>
                    </Grid>
                </Viewbox>
            </ScrollViewer>
        </DockPanel>
        </Border>
    </DataTemplate>

    <!-- NINA Options page entry: key is "<plugin Name>_Options". Uses NINA's normal styling. -->
    <DataTemplate x:Key="Polar Align Live_Options" DataType="{x:Type local:PolarAlignLivePlugin}">
        <StackPanel Margin="0,6">
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Night mode" Width="140" VerticalAlignment="Center" />
                <RadioButton GroupName="OptNight" Content="On" Margin="0,0,16,0" VerticalAlignment="Center"
                             IsChecked="{Binding Theme.NightOn, Mode=TwoWay}" />
                <RadioButton GroupName="OptNight" Content="Off" VerticalAlignment="Center"
                             IsChecked="{Binding Theme.NightOff, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Night colour" Width="140" VerticalAlignment="Center" />
                <RadioButton GroupName="OptColor" Content="Red" Margin="0,0,16,0" VerticalAlignment="Center"
                             IsChecked="{Binding Theme.ColorRed, Mode=TwoWay}" />
                <RadioButton GroupName="OptColor" Content="Green" Margin="0,0,16,0" VerticalAlignment="Center"
                             IsChecked="{Binding Theme.ColorGreen, Mode=TwoWay}" />
                <RadioButton GroupName="OptColor" Content="White" VerticalAlignment="Center"
                             IsChecked="{Binding Theme.ColorWhite, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Brightness" Width="140" VerticalAlignment="Center" />
                <Slider Width="200" Minimum="15" Maximum="100" SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                        Value="{Binding Theme.DimmerPercent, Mode=TwoWay}" />
                <TextBlock Text="{Binding Theme.DimmerText}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.7"
                       Text="Night mode off = NINA's normal green and white. Applies to the Polar Align Live panel." />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
